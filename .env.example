# Copia este archivo a .env.local y rellena los valores. No subas .env.local.

# Conexión de la aplicación. En Neon o Supabase usa la URL del pooler (PgBouncer).
DATABASE_URL=postgresql://usuario:clave@host-pooler.ejemplo/base?sslmode=require

# Conexión directa, solo para migraciones. Si no la pones, las migraciones usan DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@host.ejemplo/base?sslmode=require

# Secreto para firmar la cookie de sesión. Mínimo 16 caracteres. Genera uno, no reutilices este texto.
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Solo para `npm run db:seed`. No hace falta en Vercel si no vas a cargar la demostración.
DEMO_PASSWORD=solo-para-la-semilla-de-demostracion

# En producción la semilla se niega salvo que pongas exactamente 1.
ALLOW_DEMO_SEED=

# Solo para `npm run db:usuario`. Crea una cuenta real (ejemplo=false).
USUARIO_NOMBRE=
USUARIO_EMAIL=
USUARIO_CLAVE=
USUARIO_ROL=
USUARIO_ISLA=
USUARIO_SECTOR=
